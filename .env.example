# =====================================================================
# Relief Stream — environment variables
# Copy to .env and fill in. Leave this file without secrets.
# A copy with the same keys and no values lives in .env.example for judges.
# =====================================================================

# ---------- App ----------
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
# Random 32+ char string. Used to turn real identities into anonymous claim IDs (HMAC).
CLAIM_ID_SALT=
# Password for the reviewer screen (reviewers can only approve/reject, never move money)
REVIEWER_ACCESS_TOKEN=

# ---------- Verification rules (deterministic, not decided by the AI) ----------
AUTO_PAYOUT_THRESHOLD=75
HUMAN_REVIEW_THRESHOLD=50
DEFAULT_PACKET_USD=50
MAX_FIRST_PACKET_USD=100
WEIGHT_PHOTO=30
WEIGHT_LOCATION=25
WEIGHT_MESSAGE=20
WEIGHT_UNIQUENESS=15
WEIGHT_VOUCHING=10

# ---------- Database ----------
# Local Docker Postgres (npm run setup), or a FREE hosted Postgres for the deploy: Neon (recommended, permanent)
# (direct connection). Hosted URLs need ?sslmode=require.
DATABASE_URL=postgresql://relief:relief@localhost:5433/relief
# Optional, for a later deploy only (the app never reads it): a hosted Postgres URL.
RENDER_DATABASE_URL=

# ---------- PayPal (developer.paypal.com → Apps & Credentials → Sandbox) ----------
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same client ID, exposed to the browser for the JS SDK donate button
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Webhook ID shown after you add a webhook URL in the app settings
PAYPAL_WEBHOOK_ID=
# Sandbox business account that acts as the relief pool
PAYPAL_POOL_BUSINESS_EMAIL=

# ---------- AI: Gemini (aistudio.google.com → Get API key) ----------
GEMINI_API_KEY=

# Check AI Studio for current model names before filling these

GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_REASONING=gemini-3.5-flash-lite
GEMINI_MODEL_VISION=gemini-3.5-flash-lite
# Fallback when Gemini hits a quota (429) or stays unavailable (503) after backoff: a Groq vision model
# (console.groq.com/docs/vision; uses GROQ_API_KEY below)
GROQ_VISION_MODEL=
# Cache validated AI results for simulator fixture claims only: on | off
# (empty = on in development, off in production). Real claims always call the AI.
AI_DEMO_CACHE=
# Zero-cost guard: max AI calls per provider per UTC day (Groq counts vision + Whisper). At the budget the
# app falls back to the other provider, then sends the claim to review. Free tiers: Flash-Lite ~500/day.
AI_DAILY_CALL_BUDGET_GEMINI=400
AI_DAILY_CALL_BUDGET_GROQ=800

# ---------- Speech to text: Whisper ----------
# groq = Groq hosted Whisper (free tier, default); local = faster-whisper on your machine (optional)
WHISPER_MODE=groq
WHISPER_LOCAL_MODEL=base
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ---------- Image matching: CLIP embeddings ----------
# local = transformers.js on CPU (free, no API) | off = never load the model (perceptual hash only, for hosts
# with < 512 MB). Without ELASTIC_URL the crop embeddings are stored and compared in Postgres. HF_API_TOKEN is not used.
CLIP_MODE=local
HF_API_TOKEN=

CLIP_MODEL_ID=Xenova/clip-vit-base-patch32
# q4 (default here: smaller, measured to keep the same near-duplicate separation) | q8
CLIP_DTYPE=q4

# ---------- Elastic Cloud (duplicate photos, nearby claims) ----------
# Optional. Leave EMPTY for the free hosted deploy (and for local runs without Docker): CLIP near-duplicates
# and vouching then run on Postgres with the same rules.
ELASTIC_URL=http://localhost:9200
ELASTIC_API_KEY=
ELASTIC_CLAIMS_INDEX=relief-claims
ELASTIC_PHOTOS_INDEX=relief-photos
# Optional Elastic Cloud (Serverless) instead of the local container: copy these into ELASTIC_URL / ELASTIC_API_KEY.
ELASTIC_CLOUD_URL=
ELASTIC_CLOUD_API_KEY=

# ---------- Disaster data (free, no keys needed) ----------
# GDACS JSON API (GeoJSON points; event polygons come from each feature's url.geometry)
GDACS_FEED_URL=https://www.gdacs.org/gdacsapi/api/Events/geteventlist/search?eventlist=FL;TC;EQ;WF;VO
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/significant_week.geojson
# on | off | empty (= on): the clearly labelled SIMULATED demo flood event (fixture zone)
SIMULATED_EVENT=

# ---------- Kernel (cloud browser for official alert pages) ----------
KERNEL_API_KEY=
# on | off | empty (= on when KERNEL_API_KEY is set): official alert-page corroboration
KERNEL_CHECK=

# ---------- Render ----------
RENDER_API_KEY=

RENDER_WORKFLOW_SERVICE_ID=
# Workflow slug for task ids (<slug>/verify_claim); shown in the Render dashboard
RENDER_WORKFLOW_SLUG=


# ---------- Zapier ----------
# Catch Hook URL that alerts reviewers when a claim scores 50–74
ZAPIER_REVIEW_WEBHOOK_URL=
# Catch Hook URL for general alerts (pool low, payout failed)
ZAPIER_ALERT_WEBHOOK_URL=
# Ops alert when the pool drops below this (USD)
POOL_LOW_USD=100

# ---------- Solana devnet + test PYUSD (public transparency trail) ----------
SOLANA_RPC_URL=https://api.devnet.solana.com
# Base58 secret key of the trail wallet (Phantom → export private key, devnet only!)
SOLANA_TRAIL_WALLET_SECRET_KEY=
# Devnet PYUSD mint address — copy it from the Google Cloud faucet / Paxos docs, do not guess
PYUSD_DEVNET_MINT=CXk2AMBfi3TwaEL2468s6zP8xq9NxTXjp9gjMgzeUynM
SOLANA_EXPLORER_BASE=https://explorer.solana.com

# ---------- Postman (optional, to sync the collection from CLI) ----------
POSTMAN_API_KEY=

# APIMatic Context Plugin runs inside Claude Code / Cursor as an MCP server, no app env var needed.

# ---------- Demo simulators ----------
# US sandbox PERSONAL accounts only. PayPal does not support domestic India-to-India payments,
# so India sandbox accounts cannot test card donations or payouts (see README).
# 3 donor account emails (comma-separated) for the manual PayPal-button test on /stream
SIM_DONOR_EMAILS=
# 6 claimant account emails (comma-separated) that receive relief payouts in npm run sim:claims
SIM_CLAIMANT_EMAILS=
