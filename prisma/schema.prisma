// Relief Stream data model — mirrors architecture.md §4.
// PRIVATE fields (never on the public dashboard or chain): Claim.paypalEmail, Claim.lat, Claim.lon, Claim.messageText.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Donation {
  id              String       @id @default(uuid()) @db.Uuid
  paypalOrderId   String       @unique @map("paypal_order_id")
  paypalCaptureId String       @unique @map("paypal_capture_id")
  donorPublicId   String       @map("donor_public_id") // HMAC of payer id, no email
  amountUsd       Decimal      @map("amount_usd") @db.Decimal(12, 2)
  remainingUsd    Decimal      @map("remaining_usd") @db.Decimal(12, 2)
  streamId        String       @map("stream_id")
  source          String       @default("paypal_button") // paypal_button | sim_card
  solanaTx        String?      @map("solana_tx")
  createdAt       DateTime     @default(now()) @map("created_at")
  allocations     Allocation[]

  @@index([donorPublicId])
  @@index([createdAt])
  @@map("donation")
}

model Claim {
  id              String     @id @default(uuid()) @db.Uuid
  claimPublicId   String     @unique @map("claim_public_id") // HMAC of PayPal email
  paypalEmail     String     @map("paypal_email") // PRIVATE
  lat             Float // PRIVATE
  lon             Float // PRIVATE
  geoCell         String     @map("geo_cell") // ~10 km grid, public
  disasterEventId String?    @map("disaster_event_id")
  photoSha256     String     @map("photo_sha256")
  photoDhash      String?    @map("photo_dhash") // 64-bit perceptual dHash (hex), set inside the photo lock
  messageText     String     @map("message_text") // PRIVATE
  status          String     @default("RECEIVED")
  score           Int?
  signals         Json?
  aiExplanation   String?    @map("ai_explanation")
  aiProvider      String?    @map("ai_provider") // gemini | groq | null (no AI call: duplicate, or both providers failed)
  aiModel         String?    @map("ai_model")
  aiCached        Boolean    @default(false) @map("ai_cached") // true = demo cache hit (fixture claims only)
  audioSha256     String?    @map("audio_sha256")
  transcript      String? // PRIVATE: voice-note transcript (never public, never on-chain)
  transcriptLang  String?    @map("transcript_lang")
  eventSource     String?    @map("event_source") // simulated | gdacs | usgs
  kernelStatus    String?    @map("kernel_status") // active | none | failed | skipped | cached
  kernelReplayUrl String?    @map("kernel_replay_url") // PRIVATE (replay URLs are sensitive): /admin only
  evidence        ClaimEvidence?
  photoEmbeddings PhotoEmbedding[]
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  decisions       Decision[]
  payouts         Payout[]

  @@index([paypalEmail])
  @@index([photoSha256])
  @@index([status])
  @@map("claim")
}

model Decision {
  id        String   @id @default(uuid()) @db.Uuid
  claimId   String   @map("claim_id") @db.Uuid
  claim     Claim    @relation(fields: [claimId], references: [id])
  actor     String // "engine" | reviewer anon id
  outcome   String // APPROVED | IN_REVIEW | REJECTED
  score     Int?
  reason    String
  solanaTx  String?  @map("solana_tx")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([claimId])
  @@map("decision")
}

model Payout {
  id            String       @id @default(uuid()) @db.Uuid
  claimId       String       @map("claim_id") @db.Uuid
  claim         Claim        @relation(fields: [claimId], references: [id])
  attempt       Int
  senderBatchId String       @unique @map("sender_batch_id") // <claim_public_id>-<claim row tag>-<attempt>
  payoutBatchId String?      @map("payout_batch_id")
  payoutItemId  String?      @map("payout_item_id")
  amountUsd     Decimal      @map("amount_usd") @db.Decimal(12, 2)
  status        String // CREATED | PENDING | SUCCESS | FAILED | UNCLAIMED | ...
  error         String?
  solanaTx      String?      @map("solana_tx")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  allocations   Allocation[]

  @@unique([claimId, attempt])
  @@map("payout")
}

model Allocation {
  id         String   @id @default(uuid()) @db.Uuid
  donationId String   @map("donation_id") @db.Uuid
  donation   Donation @relation(fields: [donationId], references: [id])
  payoutId   String   @map("payout_id") @db.Uuid
  payout     Payout   @relation(fields: [payoutId], references: [id])
  amountUsd  Decimal  @map("amount_usd") @db.Decimal(12, 2)

  @@unique([donationId, payoutId])
  @@map("allocation")
}

model WebhookEvent {
  eventId    String   @id @map("event_id")
  eventType  String   @map("event_type")
  payload    Json
  receivedAt DateTime @default(now()) @map("received_at")

  @@map("webhook_event")
}

// Demo cache: validated AI results for simulator FIXTURE claims only (AI_DEMO_CACHE). Not demo data,
// so sim:reset keeps it. Holds scores + explanation only, never photos, messages or emails.
model AiCache {
  key           String   @id // sha256(photo sha | message sha | model | prompt version)
  provider      String // gemini | groq
  model         String
  photoSha256   String   @map("photo_sha256")
  messageSha256 String   @map("message_sha256")
  promptVersion String   @map("prompt_version")
  assessment    Json
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("ai_cache")
}

// Photo + voice bytes, held ONLY until verification finishes, then deleted (verify-claim). Lets a
// Render Workflows task fetch evidence by claim id instead of passing bytes through task arguments.
model ClaimEvidence {
  claimId   String   @id @map("claim_id") @db.Uuid
  claim     Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  photo     Bytes
  photoMime String   @map("photo_mime")
  audio     Bytes?
  audioMime String?  @map("audio_mime")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("claim_evidence")
}

// CLIP crop embeddings, used ONLY when Elasticsearch is not configured (free hosting): the same rows as the
// Elastic photos index (claim public id + crop variant + 512 float32), compared in code (lib/search/photos-pg).
// No PII. Deleted with the claim.
model PhotoEmbedding {
  claimPublicId String   @map("claim_public_id")
  claim         Claim    @relation(fields: [claimPublicId], references: [claimPublicId], onDelete: Cascade)
  variant       String // full | c80 | c65 | tl75 | tr75 | bl75 | br75
  vec           Bytes // 512 × float32 LE, unit length
  createdAt     DateTime @default(now()) @map("created_at")

  @@id([claimPublicId, variant])
  @@index([createdAt])
  @@map("photo_embedding")
}

// Shared cache for disaster feeds and Kernel alert-page checks (all workflow instances see it).
model FeedCache {
  key       String   @id
  body      Json
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@map("feed_cache")
}

// De-duplicates Zapier alerts (one per key, e.g. review:<claim_public_id> or pool_low:<hour>).
model AlertSent {
  key    String   @id
  kind   String
  sentAt DateTime @default(now()) @map("sent_at")

  @@map("alert_sent")
}

// AI cost guard: calls per provider per UTC day (gemini | groq; Groq counts vision + Whisper together).
// A call is reserved atomically BEFORE it is made, so the daily budget can never be overshot.
model AiUsage {
  day       String // YYYY-MM-DD (UTC)
  provider  String
  calls     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([day, provider])
  @@map("ai_usage")
}

// Public Solana devnet trail: one entry per donation, decision (engine + reviewer) and successful payout.
// Queued in the same flow, sent in the background with retries, so a chain problem never blocks or
// duplicates a PayPal action. memo = RS|v1|<type>|<public_id>|<amount_usd>|<sha256 of the public row JSON>.
model TrailEntry {
  id            String    @id @default(uuid()) @db.Uuid
  kind          String // donation | decision | payout
  refId         String    @map("ref_id") @db.Uuid // id of the donation / decision / payout row
  publicId      String    @map("public_id") // donor public id or claim public id (never PII)
  type          String // donation | decision.approved | decision.in_review | decision.rejected | payout
  amountUsd     String    @map("amount_usd")
  rowJson       Json      @map("row_json") // the public fields that were hashed (anyone can re-hash them)
  rowSha256     String    @map("row_sha256")
  memo          String
  status        String    @default("PENDING") // PENDING | SENDING | SENT | CONFIRMED | FAILED | DISABLED
  attempts      Int       @default(0)
  signature     String?
  mode          String? // pyusd+memo | memo-only
  error         String?
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  confirmedAt   DateTime? @map("confirmed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([kind, refId])
  @@index([status, nextAttemptAt])
  @@map("trail_entry")
}
